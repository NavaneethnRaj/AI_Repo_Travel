{
  "libraryVersion": "wayfarer-travel-ui/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "Reply": {
      "$ref": "#/$defs/Reply"
    },
    "DestinationCard": {
      "$ref": "#/$defs/DestinationCard"
    }
  },
  "required": [
    "Reply",
    "DestinationCard"
  ],
  "additionalProperties": false,
  "$defs": {
    "Reply": {
      "type": "object",
      "properties": {
        "children": {
          "minItems": 1,
          "maxItems": 24,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DestinationCard"
          }
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "id": "Reply",
      "description": "The required root with one to 24 destination cards."
    },
    "DestinationCard": {
      "type": "object",
      "properties": {
        "placeId": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "bestMonths": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "costRangeMinor": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "placeId",
        "why",
        "currency"
      ],
      "additionalProperties": false,
      "id": "DestinationCard",
      "description": "A curated destination and an optional daily cost estimate in minor currency units."
    }
  }
}
