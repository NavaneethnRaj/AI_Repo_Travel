# LLM provider (mock or gemini)
PROVIDER=mock

# Google Gemini API key (leave blank when using mock provider)
GEMINI_API_KEY=

# HTTP server port outside Docker only. Compose sets this value.
PORT=8080

# Persistent data directory outside Docker only. Compose sets this value.
DATA_DIR=/data

# Comma-separated exact origins allowed for authenticated writes.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Use 1 only on loopback HTTP. Compose sets 1 for its local listeners.
LOCAL_HTTP_COOKIES=0

# Set either switch to 0 to disable upstream requests for that adapter.
WEATHER_ENABLED=1
PLACES_ENABLED=1
